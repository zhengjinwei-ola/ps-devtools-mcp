PS_TEST_DB_HOST=test-rds.example.internal
PS_TEST_DB_PORT=3306
PS_TEST_DB_USER=readonly
PS_TEST_DB_PASSWORD=replace-from-secret-store
PS_TEST_DB_XIANSHI_DATABASE=xianshi
PS_TEST_DB_CONFIG_DATABASE=config

PS_TEST_REDIS_ADDRESS=127.0.0.1:6379
PS_TEST_REDIS_DATABASE=0

PS_LOG_MCP_COMMAND=/home/ecs-user/webroot/psl-test-logs-mcp/bin/psl-test-logs-mcp
PS_LOG_MCP_ARGS_JSON='["--config=/home/ecs-user/webroot/psl-test-logs-mcp/configs/sources.json"]'

# 部署历史落盘（可选）：终态任务追加 JSONL，进程重启后仍可经 get_recent_deployments /
# get_test_deployment_status 查询。不设置则纯内存历史，重启即清空。
#PS_MCP_DEPLOY_HISTORY_PATH=/home/ecs-user/webroot/ps-devtools-mcp/data/deploy-history.jsonl

# 部署后冒烟检查（可选）：按服务配置健康探针 URL，失败时部署终态为 deployed_unhealthy。
# 见 config/deploy-smoke.example.json。
#PS_MCP_DEPLOY_SMOKE_CONFIG=/home/ecs-user/webroot/ps-devtools-mcp/config/deploy-smoke.json

# Supervisor 进程日志尾部白名单（可选）：tail_test_process_logs 的数据源。
# 见 config/process-logs.004.example.json。不设置时该工具返回未配置错误。
#PS_MCP_PROCESS_LOGS_CONFIG=/home/ecs-user/webroot/ps-devtools-mcp/config/process-logs.004.json

PS_MCP_TRANSPORT=http
PS_MCP_LISTEN_ADDR=127.0.0.1:18081
PS_MCP_AUTH_TOKENS_JSON='{"developer":"replace-with-a-64-hex-token"}'
